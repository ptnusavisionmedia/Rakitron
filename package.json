{
  "name": "rakitron",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/serve.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.mjs",
    "assets": "node --experimental-strip-types scripts/generate-assets.cjs && npm run assets:body",
    "assets:hand": "node --experimental-strip-types scripts/export-hand.mjs",
    "assets:body": "node --experimental-strip-types scripts/export-body.mjs"
  },
  "dependencies": {
    "@react-three/fiber": "9.8.2",
    "lucide-react": "0.544.0",
    "next": "15.5.29",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "three": "0.182.0"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.182.0",
    "typescript": "5.9.3"
  },
  "type": "module"
}
